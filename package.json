{
  "name": "@t3code/plugin-bob",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "mcp": "bun src/mcp.ts",
    "dev:fake-bob": "bun scripts/fake-bob.ts",
    "dev:host": "bun scripts/dev-host.ts",
    "inspect": "bunx @modelcontextprotocol/inspector@2.13.0 -e BOB_API_URL=${BOB_API_URL:-http://localhost:4319} -e BOB_WORKSPACE_ID=${BOB_WORKSPACE_ID:-00000000-0000-4000-8000-000000000001} -- bun src/mcp.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/bun": "1.3.14",
    "happy-dom": "^21.0.4"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "bin": {
    "bob-t3-plugin-mcp": "src/mcp.ts"
  }
}
