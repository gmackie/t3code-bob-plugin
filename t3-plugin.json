{
  "schemaVersion": 2,
  "id": "com.t3code.bob",
  "displayName": "Bob",
  "version": "0.3.1",
  "description": "Bob planning, runs and SDLC for agents and panels, on Bob's hosted MCP server.",
  "mcpServer": {
    "name": "bob",
    "transport": {
      "type": "http",
      "url": "https://bob.blder.bot/mcp",
      "headers": [],
      "auth": {
        "type": "oauth",
        "scopes": [
          "bob:read"
        ]
      }
    }
  },
  "contributes": {
    "panels": [
      {
        "id": "bob-workspace",
        "title": "Bob planning",
        "scope": "project",
        "resourceUri": "ui://bob/workspace.html"
      },
      {
        "id": "bob-runs",
        "title": "Bob runs",
        "scope": "thread",
        "resourceUri": "ui://bob/workspace.html"
      },
      {
        "id": "bob-sdlc",
        "title": "Bob SDLC",
        "scope": "thread",
        "resourceUri": "ui://bob/sdlc.html"
      },
      {
        "id": "bob-sdlc-fleet",
        "title": "Bob SDLC fleet",
        "scope": "project",
        "resourceUri": "ui://bob/sdlc.html"
      }
    ],
    "commands": [
      {
        "id": "bob-open-planning",
        "title": "Bob: Open planning",
        "panel": "bob-workspace"
      },
      {
        "id": "bob-open-runs",
        "title": "Bob: Open runs for this thread",
        "panel": "bob-runs"
      },
      {
        "id": "bob-open-sdlc",
        "title": "Bob: Open SDLC for this thread",
        "panel": "bob-sdlc"
      },
      {
        "id": "bob-open-sdlc-fleet",
        "title": "Bob: Open SDLC fleet",
        "panel": "bob-sdlc-fleet"
      }
    ]
  },
  "t3Tools": []
}
