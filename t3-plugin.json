{
  "schemaVersion": 2,
  "id": "com.t3code.bob",
  "displayName": "Bob",
  "version": "0.2.0",
  "mcpServer": {
    "name": "bob",
    "transport": {
      "type": "stdio",
      "command": "bun",
      "args": ["src/mcp.ts"],
      "env": [
        { "name": "BOB_API_URL", "value": "" },
        { "name": "BOB_API_TOKEN", "value": "", "sensitive": true },
        { "name": "BOB_WORKSPACE_ID", "value": "" },
        { "name": "LINEAR_API_URL", "value": "https://api.linear.app/graphql" },
        { "name": "LINEAR_API_TOKEN", "value": "", "sensitive": true },
        { "name": "LINEAR_WORKSPACE", "value": "" },
        { "name": "BOB_POLL_SECONDS", "value": "60" }
      ]
    },
    "variables": [
      { "name": "BOB_API_URL", "title": "Bob API endpoint", "sensitive": false },
      { "name": "BOB_API_TOKEN", "title": "Bob API token", "sensitive": true },
      { "name": "BOB_WORKSPACE_ID", "title": "Bob workspace id", "sensitive": false },
      { "name": "LINEAR_API_URL", "title": "Linear-compatible endpoint", "sensitive": false },
      { "name": "LINEAR_API_TOKEN", "title": "Linear-compatible API token", "sensitive": true },
      { "name": "LINEAR_WORKSPACE", "title": "Linear-compatible workspace", "sensitive": false },
      { "name": "BOB_POLL_SECONDS", "title": "Refresh interval in seconds (15-3600)", "sensitive": false }
    ]
  },
  "contributes": {
    "panels": [
      { "id": "bob.workspace", "title": "Bob planning", "scope": "project", "resourceUri": "ui://bob/workspace.html" },
      { "id": "bob.runs", "title": "Bob runs", "scope": "thread", "resourceUri": "ui://bob/workspace.html" }
    ],
    "commands": [
      { "id": "bob.open-planning", "title": "Bob: Open planning", "panel": "bob.workspace" },
      { "id": "bob.open-runs", "title": "Bob: Open runs for this thread", "panel": "bob.runs" }
    ]
  },
  "t3Tools": []
}
